<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed - MicroCart</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap');
        
        body {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.7;
            color: #1e293b;
            margin: 0;
            padding: 0;
            background-color: #f8fafc;
        }
        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #f8fafc;
            padding: 40px 0;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
        }
        .header {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            padding: 60px 40px;
            text-align: center;
            color: white;
        }
        .logo {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 20px;
            display: block;
        }
        .logo span { color: #c7d2fe; }
        .content {
            padding: 50px 40px;
        }
        .order-badge {
            display: inline-block;
            padding: 8px 16px;
            background: #f1f5f9;
            color: #475569;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 30px;
        }
        .item-row {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .item-image {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            object-cover: cover;
            margin-right: 20px;
            background: #f8fafc;
        }
        .item-details {
            flex-grow: 1;
        }
        .item-name {
            font-weight: 700;
            font-size: 16px;
            margin: 0;
        }
        .item-meta {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }
        .item-price {
            font-weight: 700;
            color: #1e293b;
        }
        .total-section {
            margin-top: 40px;
            padding-top: 30px;
            border-top: 2px dashed #e2e8f0;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .total-label { color: #64748b; font-weight: 600; }
        .total-value { font-weight: 800; font-size: 24px; color: #6366f1; }
        .button {
            display: inline-block;
            padding: 16px 32px;
            background: #1e293b;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 16px;
            font-weight: 700;
            margin-top: 40px;
            text-align: center;
            width: 100%;
            box-sizing: border-box;
        }
        .footer {
            padding: 40px;
            text-align: center;
            font-size: 13px;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                
                                <!-- Premium CSS Logo -->
                <div style="margin-bottom: 25px; text-align: center;">
                    <div style="display: inline-block; width: 72px; height: 72px; background: rgba(255, 255, 255, 0.15); border: 2px solid rgba(255, 255, 255, 0.4); border-radius: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.15); position: relative; text-align: center; line-height: 72px;">
                        <span style="font-size: 38px; vertical-align: middle;">🛍️</span>
                        <div style="position: absolute; top: -4px; right: -4px; width: 14px; height: 14px; background: #fbbf24; border-radius: 50%; box-shadow: 0 0 10px rgba(251, 191, 36, 0.8);"></div>
                    </div>
                </div>
                <div style="font-size: 36px; font-weight: 900; letter-spacing: -1.5px; color: #ffffff; font-family: 'Outfit', sans-serif; margin-bottom: 15px; text-align: center;">
                    Micro<span style="color: #a5b4fc;">Cart</span><span style="color: #fbbf24;">.</span>
                </div>
                <h1>We've Got Your Order! 🎉</h1>
                <p>Thanks for shopping with us, {{name}}.</p>
            </div>
            <div class="content">
                <div class="order-badge">Order ID: #{{orderId}}</div>
                
                <h3 style="margin-bottom: 20px;">Order Summary</h3>
                {{#each items}}
                <div class="item-row">
                    {{#if image}}
                    <img src="{{image}}" class="item-image" alt="{{productName}}">
                    {{else}}
                    <div class="item-image" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 20px;">📦</div>
                    {{/if}}
                    <div class="item-details">
                        <p class="item-name">{{productName}}</p>
                        <p class="item-meta">Quantity: {{quantity}}</p>
                    </div>
                    <div class="item-price">Rs {{price}}</div>
                </div>
                {{/each}}

                <div class="total-section">
                    <div class="total-row">
                        <span class="total-label">Shipping</span>
                        <span style="font-weight: 700; color: #10b981;">FREE</span>
                    </div>
                    <div class="total-row" style="margin-top: 15px;">
                        <span class="total-label" style="font-size: 18px; color: #1e293b;">Total Amount</span>
                        <span class="total-value">Rs {{totalAmount}}</span>
                    </div>
                </div>

                <p style="margin-top: 40px; font-size: 14px; color: #64748b;">
                    <strong>Shipping to:</strong><br>
                    {{address}}
                </p>

                <a href="http://localhost:3000/orders" class="button">Track Your Order</a>
            </div>
            <div class="footer">
                <p>&copy; 2026 MicroCart Inc. All rights reserved.</p>
                <p>Questions? Reply to this email or visit our support center.</p>
            </div>
        </div>
    </div>
</body>
</html>
