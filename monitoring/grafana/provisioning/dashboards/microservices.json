      "targets": [{ "expr": "{service=~\"api-gateway.*\"} | {container=~\".*api-gateway.*\"}", "legendFormat": "", "refId": "A" }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 43 },
      "id": 43,
      "title": "👤 User Service Logs",
      "type": "logs",
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=~\"user-service.*\"} | {container=~\".*user-service.*\"}", "legendFormat": "", "refId": "A" }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
